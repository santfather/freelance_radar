# ── Провайдер для анализа по умолчанию ──
LLM_PROVIDER=ollama  # ollama | deepseek | gemini

# ── Ollama (локальная LLM) ──
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_HOST=http://localhost:11434

# ── DeepSeek API ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Google Gemini API ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── База данных ──
DB_PATH=radar.db

# ── Коллектор исторических материалов ──
# Корень хранения скачанных файлов:
#   assets/archive/<city>/<slug>/...     — оригиналы
#   assets/production/<city>/<slug>/...  — оптимизированные (2048px, JPEG q85)
#   assets/thumbnails/<city>/<slug>/...  — миниатюры (512px, JPEG q75)
ASSETS_ROOT=./assets

# Ключ для Europeana API (бесплатно): https://pro.europeana.eu/page/get-api-key
EUROPEANA_API_KEY=your_key_here

# Rijksmuseum (бесплатный ключ): https://www.rijksmuseum.nl/en/rijksstudio/start
RIJKSMUSEUM_API_KEY=your_key_here

# British Museum — публичного REST API нет (SPARQL, см. collectors/britishmuseum.py);
# ключ зарезервирован на случай появления ключевого доступа
BRITISH_MUSEUM_API_KEY=your_key_here

# MET Museum — открытый API, ключ не требуется (регистрация опциональна)
MET_API_KEY=your_key_here  # опционально

# Prometheus / Deutsche Digitale Bibliothek (бесплатный oauth_consumer_key):
# https://www.deutsche-digitale-bibliothek.de/content/entwicklung
DDB_API_KEY=your_key_here

# API miasta Warszawa (опционально, зарезервировано)
WARSAW_API_KEY=your_key_here

# Szukaj w Archiwach / Archiwa Państwowe (опционально)
ARCHIVES_API_KEY=your_key_here

# LOC (Библиотека Конгресса США) — зарезервировано под опциональный источник
LOC_API_KEY=your_key_here

# ── JWT (аутентификация) ──
# Сгенерируйте случайную строку: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
