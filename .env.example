# ── Провайдер для анализа по умолчанию ──
LLM_PROVIDER=ollama  # ollama | deepseek | gemini

# ── Ollama (локальная LLM) ──
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_HOST=http://localhost:11434

# ── DeepSeek API ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Google Gemini API ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── База данных ──
DB_PATH=radar.db

# ── JWT (аутентификация) ──
# Сгенерируйте случайную строку: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
